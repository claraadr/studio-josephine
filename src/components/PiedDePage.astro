---
/**
 * Pied de page (maquette de Clara) : logo et présentation, liens du site, contact.
 * Les liens légaux, obligatoires, sont ajoutés sur une ligne discrète en bas.
 */
import Logo from './Logo.astro';
import ACompleter from './ACompleter.astro';
import { studio } from '../config';
import { url } from '../lib/url';
---

<footer class="pied">
  <div class="pied__grille">
    <div class="pied__studio">
      <Logo largeur="clamp(11rem, 16vw, 15.25rem)" />
      <p class="pied__metier">Graphiste &amp; webdesigner freelance à Angers</p>
      <p class="pied__texte">
        Studio Joséphine accompagne les indépendants, commerçants et petites entreprises d’Angers et de l’Anjou dans la
        création de leur identité visuelle, de leur site internet et de leurs supports imprimés&nbsp;: logo, charte
        graphique, webdesign et packaging.
      </p>
    </div>

    <nav class="pied__colonne" aria-labelledby="pied-studio">
      <h2 class="pied__titre" id="pied-studio">Studio Joséphine</h2>
      <ul>
        <li><a href={url('/projets/')}>Réalisations</a></li>
        <li><a href={url('/services/')}>Services</a></li>
        <li><a href={url('/a-propos/')}>À propos</a></li>
        <li><a href={url('/contact/')}>Contact</a></li>
      </ul>
    </nav>

    <div class="pied__colonne">
      <h2 class="pied__titre">Contact</h2>
      <p>
        {
          studio.email ? (
            <a class="pied__email" href={`mailto:${studio.email}`}>
              {studio.email}
            </a>
          ) : (
            <ACompleter quoi="adresse email" />
          )
        }
        <br />À Angers, et partout en France, à distance
      </p>
      {studio.linkedin && <p class="pied__linkedin"><a href={studio.linkedin}>LinkedIn</a></p>}
    </div>
  </div>

  <div class="pied__legal">
    <a href={url('/mentions-legales/')}>Mentions légales</a>
    <a href={url('/confidentialite/')}>Confidentialité</a>
  </div>
</footer>

<style>
  .pied {
    width: min(75rem, 100% - 2 * var(--marge));
    margin-inline: auto;
    padding-block: clamp(3rem, 2rem + 3vw, 5.2rem) var(--space-l);
  }

  .pied__grille {
    display: grid;
    gap: var(--space-l);
  }

  .pied__studio {
    display: grid;
    gap: var(--space-2xs);
    justify-items: start;
    max-inline-size: 22.5rem;
  }

  .pied__metier {
    margin-top: var(--space-s);
    font-weight: 700;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .pied__texte {
    line-height: 1.35;
  }

  .pied__titre {
    margin-bottom: var(--space-xs);
    font-family: var(--font-texte);
    font-size: 1.125rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .pied__colonne ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pied__colonne ul a {
    display: inline-flex;
    align-items: center;
    min-height: 2.3rem;
    text-decoration-line: none;
  }

  .pied__colonne ul a:hover {
    text-decoration-line: underline;
  }

  .pied__colonne p {
    line-height: 1.4;
  }

  .pied__email {
    font-style: italic;
    font-weight: 700;
    text-decoration-line: none;
  }

  .pied__email:hover {
    text-decoration-line: underline;
  }

  .pied__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-m);
    margin-top: var(--space-xl);
    padding-top: var(--space-s);
    border-top: var(--filet);
    font-size: 0.875rem;
  }

  .pied__legal a {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    color: var(--c-texte-secondaire);
  }

  @media (min-width: 48em) {
    .pied__grille {
      grid-template-columns: minmax(0, 475fr) minmax(0, 289fr) minmax(0, 436fr);
      align-items: start;
    }
  }
</style>
