---
/** Flèche dessinée (les polices du site n'ont pas de glyphe flèche). Décorative. */
interface Props {
  sens?: 'droite' | 'gauche' | 'haut' | 'bas';
}
const { sens = 'droite' } = Astro.props;
const rotation = { droite: 0, bas: 90, gauche: 180, haut: 270 }[sens];
---

<svg class="fleche" viewBox="0 0 20 12" aria-hidden="true" focusable="false" style={`--rotation: ${rotation}deg`}>
  <path
    d="M1 6.3c5.6-.4 11.4-.5 17-.2M13.2 1.4c1.7 1.7 3.4 3.2 5 4.7-1.7 1.4-3.4 3-5 4.6"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
