---
/**
 * En-tête (maquette de Clara) : le logo, « Réalisations », « Services » et le bouton « On en parle ? ».
 * Sur mobile, un bouton « Menu » ouvre la liste ; sans JavaScript, les liens restent visibles.
 */
import Logo from './Logo.astro';
import { url } from '../lib/url';

const liens = [
  { href: '/projets/', texte: 'Réalisations' },
  { href: '/services/', texte: 'Services' },
];

const chemin = Astro.url.pathname;
function etat(href: string): 'page' | 'true' | undefined {
  const cible = url(href);
  if (chemin === cible) return 'page';
  if (chemin.startsWith(cible)) return 'true';
  return undefined;
}
---

<header class="entete">
  <div class="entete__barre">
    <Logo lien largeur="clamp(9.5rem, 12.3vw, 11.625rem)" />
    <nav class="nav" aria-label="Navigation principale">
      <button class="nav__bouton" type="button" aria-expanded="false" aria-controls="nav-liste" hidden>
        Menu
        <svg viewBox="0 0 22 12" aria-hidden="true" focusable="false">
          <path d="M1.5 2.2c6.4-.5 12.7-.6 19 .1M1.5 9.6c6.2.4 12.6.4 19-.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
        </svg>
      </button>
      <ul class="nav__liste" id="nav-liste">
        {
          liens.map((lien) => (
            <li>
              <a class="nav__lien" href={url(lien.href)} aria-current={etat(lien.href)}>
                {lien.texte}
              </a>
            </li>
          ))
        }
        <li>
          <a class="nav__contact" href={url('/contact/')} aria-current={etat('/contact/')}>On en parle&nbsp;?</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('.nav');
  const bouton = nav?.querySelector<HTMLButtonElement>('.nav__bouton');
  if (nav && bouton) {
    const mobile = window.matchMedia('(max-width: 47.99em)');
    const fermer = (rendreLeFocus = false) => {
      nav.dataset.ouvert = 'false';
      bouton.setAttribute('aria-expanded', 'false');
      if (rendreLeFocus) bouton.focus();
    };
    nav.dataset.amelioree = 'true';
    bouton.hidden = false;
    fermer();
    bouton.addEventListener('click', () => {
      const ouvert = nav.dataset.ouvert === 'true';
      nav.dataset.ouvert = String(!ouvert);
      bouton.setAttribute('aria-expanded', String(!ouvert));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.dataset.ouvert === 'true') fermer(true);
    });
    mobile.addEventListener('change', () => fermer());
  }
</script>

<style>
  .entete {
    position: relative;
    z-index: 20;
  }

  .entete__barre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
    padding: clamp(1.25rem, 0.6rem + 2.3vw, 3rem) clamp(1.25rem, 5.5vw, 5.2rem) var(--space-s);
  }

  .nav__liste {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) clamp(1.5rem, 0.5rem + 3vw, 4.1rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__lien {
    display: inline-flex;
    align-items: center;
    min-height: var(--cible-min);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration-line: none;
  }

  .nav__lien:hover,
  .nav__lien[aria-current] {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }

  .nav__lien[aria-current='page'] {
    text-decoration-thickness: 2px;
  }

  /* Bouton anis « On en parle ? » */
  .nav__contact {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.35em 1.8em;
    border-radius: 999px;
    background: var(--c-anis);
    color: var(--c-bordeaux);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.18s ease;
  }

  .nav__contact:hover,
  .nav__contact[aria-current] {
    background: color-mix(in srgb, var(--c-anis) 86%, var(--c-bordeaux));
  }

  .nav__bouton {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    min-height: var(--cible-min);
    padding: 0 0.2em;
    border: 0;
    background: none;
    color: inherit;
    font: 500 1rem / 1 var(--font-texte);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .nav__bouton svg {
    width: 1.35rem;
    height: auto;
  }

  @media (max-width: 47.99em) {
    .nav[data-amelioree='true'] .nav__liste {
      display: none;
    }

    .nav[data-ouvert='true'] .nav__liste {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: grid;
      justify-items: start;
      gap: 0;
      padding: var(--space-2xs) clamp(1.25rem, 5.5vw, 5.2rem) var(--space-m);
      background: var(--c-lin);
      border-bottom: 1px solid var(--c-bordeaux);
    }

    .nav[data-ouvert='true'] .nav__liste li {
      width: 100%;
    }

    .nav[data-ouvert='true'] .nav__liste li + li {
      border-top: var(--filet);
    }

    .nav[data-ouvert='true'] .nav__lien {
      width: 100%;
      min-height: 3.25rem;
    }

    .nav[data-ouvert='true'] .nav__contact {
      margin-block: var(--space-s) 0;
    }
  }

  @media (min-width: 48em) {
    .nav__bouton {
      display: none;
    }
  }
</style>
