---
/**
 * « Ces entreprises m'ont fait confiance » (maquette) : les avis des clients, sur fond de vichy,
 * dans un carrousel horizontal. Chaque avis vient de la fiche du projet (champs logo et avis).
 * Sans JavaScript, la bande défile au doigt, à la souris ou au clavier ; avec, deux flèches s'ajoutent.
 */
import { Image, getImage } from 'astro:assets';
import Fleche from './Fleche.astro';
import vichy from '../assets/textures/vichy.jpg';
import { projetsTries } from '../lib/projets';
import { url } from '../lib/url';
import { typo } from '../lib/typographie.mjs';

const projets = (await projetsTries())
  .filter((p) => p.data.avis)
  .sort((a, b) => (a.data.avis?.ordre ?? 0) - (b.data.avis?.ordre ?? 0));

const texture = await getImage({ src: vichy, format: 'webp', width: 736, quality: 70 });
---

{
  projets.length > 0 && (
    <section class="avis" aria-labelledby="avis-titre" style={`--vichy: url('${texture.src}')`}>
      <h2 id="avis-titre">Ces entreprises m’ont fait confiance</h2>
      <div class="avis__piste" id="avis-piste" role="region" aria-label="Avis des clients" tabindex="0">
        {projets.map((p) => (
          <article class="avis__carte" aria-label={`Avis de ${p.data.avis?.nom}, ${p.data.titre}`}>
            {p.data.logo && (
              <Image src={p.data.logo} alt={p.data.titre} height={42} densities={[1, 2]} class="avis__logo" />
            )}
            <blockquote class="avis__citation">
              <p>{typo(`«${p.data.avis?.citation}»`)}</p>
            </blockquote>
            <p class="avis__auteur">
              {typo(p.data.avis?.nom ?? '')}
              <br />
              <em>{typo(p.data.avis?.role ?? '')}</em>
            </p>
            <a class="avis__lien" href={url(`/projets/${p.id}/`)}>
              Découvrir le projet<span class="visually-hidden"> {typo(p.data.titre)}</span>
            </a>
          </article>
        ))}
      </div>
      <div class="avis__fleches" hidden>
        <button type="button" class="avis__fleche" data-sens="-1" aria-controls="avis-piste">
          <span class="visually-hidden">Avis précédents</span>
          <Fleche sens="gauche" />
        </button>
        <button type="button" class="avis__fleche" data-sens="1" aria-controls="avis-piste">
          <span class="visually-hidden">Avis suivants</span>
          <Fleche />
        </button>
      </div>
    </section>
  )
}

<script>
  const section = document.querySelector<HTMLElement>('.avis');
  const piste = section?.querySelector<HTMLElement>('.avis__piste');
  const fleches = section?.querySelector<HTMLElement>('.avis__fleches');
  if (section && piste && fleches) {
    const boutons = [...fleches.querySelectorAll<HTMLButtonElement>('.avis__fleche')];
    const doux = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pas = () => {
      const carte = piste.querySelector<HTMLElement>('.avis__carte');
      const ecart = parseFloat(getComputedStyle(piste).columnGap) || 0;
      return carte ? carte.offsetWidth + ecart : piste.clientWidth;
    };
    const maj = () => {
      const fin = piste.scrollWidth - piste.clientWidth - 2;
      boutons[0].setAttribute('aria-disabled', String(piste.scrollLeft <= 2));
      boutons[1].setAttribute('aria-disabled', String(piste.scrollLeft >= fin));
      fleches.hidden = fin <= 0; // tout tient à l'écran : pas besoin de flèches
    };
    for (const b of boutons) {
      b.addEventListener('click', () => {
        if (b.getAttribute('aria-disabled') === 'true') return;
        piste.scrollBy({ left: Number(b.dataset.sens) * pas(), behavior: doux ? 'smooth' : 'auto' });
      });
    }
    piste.addEventListener('scroll', () => requestAnimationFrame(maj), { passive: true });
    window.addEventListener('resize', maj);
    section.classList.add('avis--ameliore');
    maj();
  }
</script>

<style>
  .avis {
    padding-block: clamp(3rem, 2rem + 3vw, 5.06rem) clamp(2.5rem, 2rem + 2vw, 3.3rem);
    background: var(--c-lin) var(--vichy) repeat left top / 57.9rem auto;
  }

  .avis h2 {
    width: min(75rem, 100% - 2 * var(--marge));
    margin-inline: auto;
    font-size: clamp(1.75rem, 1.1rem + 1.8vw, 2.375rem);
    text-align: center;
  }

  .avis__piste {
    --bord: max(var(--marge), (100% - 75rem) / 2);
    display: flex;
    gap: 1.75rem;
    margin-top: clamp(2rem, 1.5rem + 1.5vw, 2.6rem);
    padding-inline: var(--bord);
    padding-block: 0.25rem;
    overflow-x: auto;
    scroll-padding-inline: var(--bord);
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  /* Avec les flèches, la barre de défilement devient inutile */
  .avis--ameliore .avis__piste {
    scrollbar-width: none;
  }

  .avis--ameliore .avis__piste::-webkit-scrollbar {
    display: none;
  }

  .avis__carte {
    position: relative; /* garde dans le carrousel les textes réservés aux lecteurs d'écran */
    flex: 0 0 min(23.8rem, 82vw);
    display: flex;
    flex-direction: column;
    padding: 2rem;
    border-radius: 2rem;
    background: var(--c-lin);
    scroll-snap-align: start;
  }

  .avis__logo {
    width: auto;
    max-width: 7.5rem;
    height: auto;
    max-height: 2.65rem;
    object-fit: contain;
    object-position: left center;
  }

  .avis__citation {
    margin: clamp(2rem, 1.5rem + 1.5vw, 3.05rem) 0 0;
    font-size: 1.15rem;
    line-height: 1.28;
  }

  .avis__auteur {
    margin-top: 1.1rem;
    line-height: 1.35;
  }

  .avis__lien {
    margin-top: auto;
    padding-top: 2.2rem;
    font-weight: 700;
  }

  .avis__fleches {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    width: min(75rem, 100% - 2 * var(--marge));
    margin: clamp(2rem, 1.5rem + 2vw, 3.5rem) auto 0;
  }

  .avis__fleche {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 50%;
    background: var(--c-bordeaux);
    color: var(--c-lin);
    cursor: pointer;
  }

  .avis__fleche :global(.fleche) {
    width: 1.15rem;
  }

  .avis__fleche[aria-disabled='true'] {
    opacity: 0.45;
    cursor: default;
  }

  .avis__fleche:hover:not([aria-disabled='true']) {
    background: color-mix(in srgb, var(--c-bordeaux) 82%, #000);
  }
</style>
