---
/** Souligné tracé à la main, sous un mot : la couleur par touches. Décoratif. */
interface Props {
  couleur?: 'rose' | 'anis' | 'corail';
  trace?: 1 | 2 | 3;
}
const { couleur = 'rose', trace = 1 } = Astro.props;
const traces = {
  1: 'M3 8.6C37 5.7 78 4.3 118 5.2c27 .6 53 2.2 79 1.1',
  2: 'M2 6.6c31 2 65 2.8 99 1.5 33-1.2 64-3.6 96-2.5',
  3: 'M4 9.1c25-3.5 56-5.3 88-4.7 37 .7 70 3 105 .7',
};
---

<span class="souligne" style={`--trait: var(--c-${couleur})`}><slot /><svg
    viewBox="0 0 200 12"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"><path d={traces[trace]}></path></svg></span>
