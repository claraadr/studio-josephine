---
/**
 * « Quelques projets » (maquette) : des cartes de 1 200 px centrées qui s'empilent au défilement.
 * Chaque carte reste collée en haut de l'écran (position: sticky) : à 96 px pour la première,
 * puis 24 px plus bas pour chaque carte suivante, et chaque nouvelle carte recouvre la précédente.
 * L'empilement est désactivé quand l'écran est trop bas pour montrer une carte entière.
 */
import Visuel from './Visuel.astro';
import Cartouche from './Cartouche.astro';
import { url } from '../lib/url';
import { typo } from '../lib/typographie.mjs';
import { familleEtiquette, nomFamille, type Projet } from '../lib/projets';

interface Props {
  projets: Projet[];
}

const { projets } = Astro.props;
// Inclinaisons relevées sur la maquette, reprises dans cet ordre
const inclinaisons = [-1.1, 1, -0.45, 1.8];
---

<div class="pile" data-pile>
  {
    projets.map((projet, i) => {
      const d = projet.data;
      const etiquettes = d.etiquettes?.filter((e) => e.trim()).length ? d.etiquettes.filter((e) => e.trim()) : d.familles.map(nomFamille);
      return (
        <article
          class="pile__carte fond-clair"
          style={`--i: ${i}; --inclinaison: ${inclinaisons[i % inclinaisons.length]}deg`}
          aria-labelledby={`pile-${projet.id}`}
        >
          <div class="pile__texte">
            <ul class="cartouches pile__etiquettes" aria-label="Disciplines">
              {etiquettes.map((e) => (
                <li>
                  <Cartouche famille={familleEtiquette(e)}>{e}</Cartouche>
                </li>
              ))}
            </ul>
            <h3 class="pile__titre" id={`pile-${projet.id}`}>
              {typo(d.titre)}
            </h3>
            {d.accroche && <p class="pile__accroche">{typo(d.accroche)}</p>}
            <p class="pile__extrait">{typo(d.extrait || d.sousTitre)}</p>
            <a class="bouton pile__lien" href={url(`/projets/${projet.id}/`)}>
              Découvrir le projet<span class="visually-hidden"> {typo(d.titre)}</span>
            </a>
          </div>
          <div class="pile__visuel">
            <Visuel
              image={d.couverture?.image}
              alt={d.couverture?.alt}
              sizes="(min-width: 75rem) 40rem, (min-width: 64em) 53vw, 92vw"
              legende={`Visuel à venir · ${typo(d.titre)}`}
            />
          </div>
        </article>
      );
    })
  }
</div>

<script>
  // L'empilement n'a de sens que si chaque carte tient entière sous son point d'accroche.
  const pile = document.querySelector<HTMLElement>('[data-pile]');
  if (pile) {
    const cartes = [...pile.querySelectorAll<HTMLElement>('.pile__carte')];
    const verifier = () => {
      pile.classList.remove('pile--a-plat');
      const accroche = Math.max(...cartes.map((c) => parseFloat(getComputedStyle(c).top) || 0));
      const hauteur = Math.max(...cartes.map((c) => c.offsetHeight));
      pile.classList.toggle('pile--a-plat', accroche + hauteur + 16 > window.innerHeight);
    };
    verifier();
    let attente = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(attente);
      attente = requestAnimationFrame(verifier);
    });
  }
</script>

<style>
  .pile {
    --accroche: 6rem; /* 96 px */
    --pas: 1.5rem; /* + 24 px par carte */
    display: grid;
    gap: clamp(2rem, 1rem + 3vw, 3rem);
    width: min(75rem, 100% - 2 * var(--marge));
    margin-inline: auto;
  }

  .pile__carte {
    display: grid;
    gap: var(--space-m);
    padding: clamp(1.25rem, 0.8rem + 1.5vw, 2.0625rem);
    border-radius: clamp(1rem, 0.6rem + 1.3vw, 1.625rem);
    background: var(--c-lin);
    color: var(--c-bordeaux);
    transform: rotate(var(--inclinaison));
    /* Ombre portée vers le haut : détache chaque carte de celle qu'elle recouvre */
    box-shadow: 0 -0.75rem 2rem -1rem rgb(30 4 12 / 0.45);
  }

  /* Empilement : seulement sur un écran assez haut ; le script affine selon la hauteur réelle des cartes */
  @media (min-height: 45em) {
    .pile__carte {
      position: sticky;
      top: calc(var(--accroche) + var(--i) * var(--pas));
    }
  }

  .pile--a-plat .pile__carte {
    position: relative;
    top: auto;
  }

  /* Une carte qui reçoit le focus au clavier passe devant les suivantes : rien n'est masqué */
  .pile__carte:has(:focus-visible) {
    z-index: 10;
  }

  .pile__texte {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .pile__etiquettes {
    gap: 0.75rem;
  }

  .pile__titre {
    margin-top: 1.1rem;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pile__accroche {
    margin-top: 0.4rem;
    font-family: var(--font-titres);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .pile__extrait {
    max-inline-size: 31rem;
    margin-top: 1.2rem;
    line-height: 1.375;
  }

  .pile__lien {
    margin-top: 1.6rem;
  }

  .pile__visuel {
    order: -1;
  }

  .pile__visuel :global(.visuel) {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 1rem;
    object-fit: cover;
  }

  @media (min-width: 64em) {
    .pile__carte {
      grid-template-columns: minmax(0, 466fr) minmax(0, 640fr);
      column-gap: 2rem;
    }

    .pile__visuel {
      order: 0;
    }

    /* L'image garde les proportions de la maquette, sans dépasser la hauteur de l'écran */
    .pile__visuel :global(.visuel) {
      aspect-ratio: auto;
      height: clamp(16rem, calc(100svh - 10.5rem - 4.5rem), 27.5rem);
    }
  }
</style>
