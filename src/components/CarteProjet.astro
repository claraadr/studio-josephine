---
/**
 * Un projet dans une liste (accueil, page Projets) : grand visuel, titre, ligne de contexte,
 * cartouches de famille. Le rythme (1 à 4) alterne les formats et les alignements ;
 * il se répète tous les quatre projets, pour rester beau avec 4 comme avec 12 projets.
 */
import Visuel from './Visuel.astro';
import Cartouche from './Cartouche.astro';
import { url } from '../lib/url';
import { typo } from '../lib/typographie.mjs';
import { nomFamille, numero, type Projet } from '../lib/projets';

interface Props {
  projet: Projet;
  index: number;
  niveau?: 'h2' | 'h3';
}

const { projet, index, niveau = 'h3' } = Astro.props;
const { titre, sousTitre, familles, couverture } = projet.data;
const rythme = (index % 4) + 1;
const tailles: Record<number, string> = {
  1: '(min-width: 64em) 60vw, 92vw',
  2: '(min-width: 64em) 40vw, 92vw',
  3: '(min-width: 64em) 75vw, 92vw',
  4: '(min-width: 64em) 48vw, 92vw',
};
const Titre = niveau;
---

<article class={`carte carte--r${rythme}`} data-familles={familles.join(' ')}>
  <div class="carte__visuel">
    <Visuel
      image={couverture?.image}
      alt={couverture?.alt}
      sizes={tailles[rythme]}
      legende={`Visuel à venir · ${titre}`}
    />
  </div>
  <div class="carte__texte">
    <span class="carte__numero" aria-hidden="true">{numero(index + 1)}</span>
    <Titre class="carte__titre"><a href={url(`/projets/${projet.id}/`)}>{typo(titre)}</a></Titre>
    <p class="carte__contexte">{typo(sousTitre)}</p>
    <ul class="cartouches" aria-label="Familles">
      {familles.map((f) => (
        <li>
          <Cartouche famille={f}>{nomFamille(f)}</Cartouche>
        </li>
      ))}
    </ul>
  </div>
</article>

<style>
  .carte {
    position: relative;
    display: grid;
    gap: var(--space-s);
    align-content: start;
  }

  .carte__visuel {
    overflow: hidden;
  }

  .carte__visuel :global(.visuel) {
    width: 100%;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .carte:hover .carte__visuel :global(.visuel) {
    transform: scale(1.015);
  }

  .carte__texte {
    display: grid;
    gap: var(--space-2xs);
    justify-items: start;
  }

  .carte__numero {
    font-family: var(--font-titres);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--c-texte-secondaire);
    font-variant-numeric: tabular-nums;
  }

  .carte__titre {
    font-size: var(--step-3);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .carte__titre a {
    text-decoration-line: none;
  }

  /* Tout le projet est cliquable ; le lien reste le titre pour les lecteurs d'écran */
  .carte__titre a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .carte:hover .carte__titre a,
  .carte__titre a:focus-visible {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
  }

  .carte:has(a:focus-visible) {
    outline: var(--focus);
    outline-offset: 6px;
  }

  .carte__titre a:focus-visible {
    outline: none;
  }

  .carte__contexte {
    max-inline-size: 34ch;
    color: var(--c-texte-secondaire);
  }

  /* Proportions des visuels selon le rythme */
  .carte--r1 :global(.visuel) {
    aspect-ratio: 3 / 2;
  }
  .carte--r2 :global(.visuel) {
    aspect-ratio: 4 / 5;
  }
  .carte--r3 :global(.visuel) {
    aspect-ratio: 16 / 9;
  }
  .carte--r4 :global(.visuel) {
    aspect-ratio: 5 / 4;
  }

  /* Grand écran : formats et alignements alternés sur la grille de 12 colonnes */
  @media (min-width: 64em) {
    .carte {
      grid-column: 1 / -1;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gouttiere);
    }

    .carte--r1 .carte__visuel {
      grid-column: 1 / 9;
    }
    .carte--r1 .carte__texte {
      grid-column: 9 / 13;
      align-self: end;
    }

    .carte--r2 .carte__visuel {
      grid-column: 8 / 13;
      grid-row: 1;
    }
    .carte--r2 .carte__texte {
      grid-column: 3 / 7;
      grid-row: 1;
      align-self: center;
    }

    .carte--r3 .carte__visuel {
      grid-column: 2 / 11;
    }
    .carte--r3 .carte__texte {
      grid-column: 2 / 8;
    }

    .carte--r4 .carte__visuel {
      grid-column: 1 / 7;
    }
    .carte--r4 .carte__texte {
      grid-column: 8 / 12;
      align-self: start;
      padding-top: var(--space-2xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carte:hover .carte__visuel :global(.visuel) {
      transform: none;
    }
  }
</style>
