---
/**
 * Accueil, d'après la maquette de Clara (Figma, export du 27 novembre 2026).
 * Textes de la maquette passés au vouvoiement, comme le reste du site.
 */
import Base from '../layouts/Base.astro';
import Bandeau from '../components/Bandeau.astro';
import PileProjets from '../components/PileProjets.astro';
import CarrouselAvis from '../components/CarrouselAvis.astro';
import { projetsTries } from '../lib/projets';
import { url } from '../lib/url';
import { typo } from '../lib/typographie.mjs';
import { studio } from '../config';
import accueil from '../data/accueil.json';

const projets = (await projetsTries()).filter((p) => p.data.accueil);

// Textes de l'accueil : src/data/accueil.json (modifiable dans Pages CMS, « Page d'accueil »)
const motsCles = accueil.motsCles;
const objetContact: Record<string, string> = { branding: 'identite', webdesign: 'site', print: 'imprime' };
const offres = accueil.offres.liste.map((o) => ({ ...o, objet: objetContact[o.famille] ?? '' }));

const adresse = new URL(url('/'), Astro.site).href;
const donnees = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${adresse}#clara`,
      name: studio.personne,
      jobTitle: 'Graphiste et webdesigner freelance',
      url: adresse,
      sameAs: studio.linkedin ? [studio.linkedin] : undefined,
      knowsAbout: ['Identité de marque', 'Direction artistique', 'Webdesign', 'UX/UI', 'Print', 'Packaging'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${adresse}#studio`,
      name: studio.nom,
      url: adresse,
      description:
        'Identité visuelle, site internet et supports imprimés pour les indépendants, commerçants et petites entreprises.',
      founder: { '@id': `${adresse}#clara` },
      email: studio.email ?? undefined,
      areaServed: 'FR',
      address: studio.ville ? { '@type': 'PostalAddress', addressLocality: studio.ville, addressCountry: 'FR' } : undefined,
    },
  ],
};
---

<Base
  titre="Studio Joséphine — graphiste & webdesigner freelance à Angers"
  titreComplet
  description="Clara Audureau, graphiste et webdesigner freelance à Angers : identité de marque, site internet et supports imprimés pour les indépendants, commerçants et petites entreprises."
  donneesStructurees={donnees}
>
  <!-- Premier écran -->
  <section class="hero" aria-labelledby="hero-titre">
    <div class="hero__decor" aria-hidden="true">
      <span class="hero__aplat hero__aplat--1"></span>
      <span class="hero__aplat hero__aplat--2"></span>
      <span class="hero__aplat hero__aplat--3"></span>
      <span class="hero__aplat hero__aplat--4"></span>
      <span class="hero__aplat hero__aplat--5"></span>
    </div>
    <div class="hero__contenu">
      <p class="hero__metier">{typo(accueil.metier)}</p>
      <h1 id="hero-titre">{typo(accueil.titre)}</h1>
      <div class="hero__actions">
        <a class="bouton bouton--anis" href={url('/projets/')}>{typo(accueil.boutonRealisations)}</a>
        <a class="bouton bouton--contour" href={url('/contact/')}>{typo(accueil.boutonContact)}</a>
      </div>
    </div>
  </section>

  <Bandeau mots={motsCles} variante="plein" label="Mes savoir-faire" />

  <!-- Ce que je peux faire pour vous -->
  <section class="offres" aria-labelledby="offres-titre">
    <div class="offres__tete">
      <h2 id="offres-titre">{typo(accueil.offres.titre)}</h2>
      <p>
        {typo(accueil.offres.introduction)}
      </p>
    </div>
    <div class="offres__liste">
      {
        offres.map((o) => (
          <article class={`offre offre--${o.famille}`} aria-labelledby={`offre-${o.famille}`}>
            <p class="cartouche cartouche--blanc offre__etiquette">{o.etiquette}</p>
            <h3 class="offre__titre" id={`offre-${o.famille}`}>
              {typo(o.titre)}
            </h3>
            <p class="offre__texte">{typo(o.texte)}</p>
            <h4 class="offre__sous-titre">Ce que vous obtenez</h4>
            <p class="offre__texte">{typo(o.obtenez)}</p>
            <p class="offre__prix">
              {o.prixAvant && <>{typo(o.prixAvant)} </>}
              <strong>{typo(o.prix)}</strong>
              {o.prixNote && <span class="offre__note">{typo(o.prixNote)}</span>}
            </p>
            <a class="bouton offre__bouton" href={url(`/contact/?objet=${o.objet}`)}>
              {o.bouton}
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Quelques projets : cartes empilées au défilement -->
  <section class="projets fond-fonce" aria-labelledby="projets-titre">
    <h2 id="projets-titre">{typo(accueil.projets.titre)}</h2>
    <PileProjets projets={projets} />
    <p class="projets__tous">
      <a class="bouton bouton--anis" href={url('/projets/')}>{typo(accueil.projets.bouton)}</a>
    </p>
  </section>

  <!-- Ces entreprises m'ont fait confiance -->
  <CarrouselAvis titre={accueil.avis.titre} />

  <!-- Appel au contact -->
  <section class="bande-contact" aria-labelledby="bande-contact-titre">
    <h2 id="bande-contact-titre">{typo(accueil.contact.titre)}</h2>
    <p>
      {typo(accueil.contact.texte)}
    </p>
    <a class="bouton bouton--anis" href={url('/contact/')}>{typo(accueil.contact.bouton)}</a>
  </section>
</Base>

<style>
  /* ---------- Premier écran ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: clamp(2rem, 1rem + 3vw, 4.25rem) var(--marge) clamp(3.5rem, 1.5rem + 6vw, 9.25rem);
    text-align: center;
  }

  .hero__contenu {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
  }

  .hero__metier {
    font-size: 1rem;
    text-transform: uppercase;
  }

  /* 50 px sur 700 px de large : les quatre lignes de la maquette */
  .hero h1 {
    max-inline-size: 14em;
    margin-top: 0.6rem;
    font-size: clamp(2rem, 3.31vw, 3.125rem);
    line-height: 1.26;
    letter-spacing: 0;
    text-wrap: wrap;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s) 2rem;
    margin-top: 2.25rem;
  }

  /* Emplacements des visuels de projets, en attendant les images */
  .hero__decor {
    display: none;
  }

  .hero__aplat {
    position: absolute;
    background: color-mix(in srgb, var(--c-bordeaux) 7%, var(--c-lin));
  }

  @media (min-width: 72em) {
    .hero__decor {
      display: block;
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .hero__aplat--1 {
      left: 17.8vw;
      top: 0.33vw;
      width: 10.05vw;
      height: 12.5vw;
    }

    .hero__aplat--2 {
      left: 0;
      top: 9.06vw;
      width: 7.4vw;
      height: 12.5vw;
    }

    .hero__aplat--3 {
      left: 3.9vw;
      bottom: 0;
      width: 17.66vw;
      height: 20.7vw;
    }

    .hero__aplat--4 {
      left: 72.35vw;
      top: 21.7vw;
      width: 10.78vw;
      height: 13.49vw;
    }

    .hero__aplat--5 {
      right: 0;
      top: 3.44vw;
      width: 15.48vw;
      height: 22.2vw;
    }
  }

  /* ---------- Ce que je peux faire pour vous ---------- */
  .offres {
    width: min(75rem, 100% - 2 * var(--marge));
    margin-inline: auto;
    padding-block: clamp(4rem, 2.5rem + 5vw, 8.1rem) clamp(4rem, 2.5rem + 5vw, 8.5rem);
  }

  .offres__tete {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    text-align: center;
  }

  .offres__tete h2,
  .projets h2 {
    font-size: clamp(1.75rem, 1.1rem + 1.8vw, 2.375rem);
  }

  .offres__tete p {
    max-inline-size: 37rem;
    line-height: 1.4;
  }

  .offres__liste {
    display: grid;
    gap: 1.8rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3.1rem);
  }

  .offre {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 2rem;
    border-radius: 2.25rem;
  }

  .offre--branding {
    background: var(--c-branding);
  }

  .offre--webdesign {
    background: var(--c-webdesign);
  }

  .offre--print {
    background: var(--c-print);
  }

  .offre__titre {
    margin-top: 1rem;
    font-size: 1.75rem;
    line-height: 1.25;
  }

  .offre__texte {
    margin-top: 0.75rem;
    line-height: 1.31;
  }

  .offre__sous-titre {
    margin-top: 1.6rem;
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .offre__sous-titre + .offre__texte {
    margin-top: 0.4rem;
  }

  .offre__prix {
    display: block;
    margin-top: auto;
    padding-top: 2rem;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .offre__prix strong {
    font-weight: 700;
  }

  .offre__note {
    display: block;
    font-size: 0.875rem;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .offre__bouton {
    min-width: min(15.6rem, 100%);
    margin-top: 1.1rem;
  }

  @media (min-width: 64em) {
    .offres__liste {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------- Quelques projets ---------- */
  .projets {
    padding-block: clamp(4rem, 2.5rem + 5vw, 8.1rem) clamp(4rem, 2.5rem + 5vw, 9rem);
    background: var(--c-bordeaux);
    color: var(--c-lin);
  }

  .projets h2 {
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.4rem);
    text-align: center;
  }

  .projets__tous {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.1rem);
  }

  /* ---------- Un projet en tête ? ---------- */
  .bande-contact {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding: clamp(4rem, 3rem + 3vw, 6.3rem) var(--marge) clamp(4rem, 3rem + 4vw, 7.6rem);
    background: var(--c-corail);
    text-align: center;
  }

  .bande-contact h2 {
    font-size: clamp(2rem, 1.3rem + 2.4vw, 3.125rem);
  }

  .bande-contact p {
    max-inline-size: 47rem;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .bande-contact .bouton {
    min-width: 13.8rem;
    margin-top: 1.25rem;
  }
</style>
