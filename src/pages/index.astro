---
import Base from '../layouts/Base.astro';
---

<Base
  titre="Studio Joséphine — site en construction"
  description="Studio Joséphine, graphiste et webdesigner indépendante : branding, webdesign, print."
  indexer={false}
>
  <div class="conteneur attente">
    <h1>Site en construction</h1>
    <p class="mesure">
      L’accueil arrive à l’étape&nbsp;2. En attendant, les fondations graphiques sont sur le
      <a href="/guide-de-styles/">guide de styles</a>.
    </p>
  </div>
</Base>

<style>
  .attente {
    display: grid;
    gap: var(--space-m);
    padding-block: var(--space-2xl);
  }
</style>
