---
import Base from '../../layouts/Base.astro';
import ACompleter from '../../components/ACompleter.astro';
import { studio } from '../../config';
import { url } from '../../lib/url';

const adresseSite = new URL(url('/'), Astro.site).href;
---

<Base titre="Mentions légales" description="Éditeur, hébergeur et propriété des contenus du site Studio Joséphine.">
  <header class="conteneur grille page-tete">
    <h1>Mentions légales</h1>
  </header>

  <div class="conteneur legal">
    <section aria-labelledby="editeur">
      <h2 id="editeur">Éditeur du site</h2>
      <p>Le site <a href={adresseSite}>{adresseSite.replace(/^https?:\/\//, '')}</a> est édité par&nbsp;:</p>
      <dl class="legal__fiche">
        <div><dt>Nom</dt><dd>{studio.personne}</dd></div>
        <div><dt>Nom commercial</dt><dd>{studio.nom}</dd></div>
        <div><dt>Statut</dt><dd>{studio.statut ?? <ACompleter quoi="statut juridique" />}</dd></div>
        <div><dt>SIRET</dt><dd>{studio.siret ?? <ACompleter quoi="numéro SIRET" />}</dd></div>
        <div><dt>Adresse</dt><dd>{studio.adresse ?? <ACompleter quoi="adresse professionnelle" />}</dd></div>
        <div>
          <dt>Email</dt>
          <dd>{studio.email ? <a href={`mailto:${studio.email}`}>{studio.email}</a> : <ACompleter quoi="adresse email" />}</dd>
        </div>
        <div><dt>Directrice de la publication</dt><dd>{studio.personne}</dd></div>
      </dl>
    </section>

    <section aria-labelledby="hebergeur">
      <h2 id="hebergeur">Hébergeur</h2>
      <p>
        GitHub, Inc. (service GitHub Pages), 88 Colin P. Kelly Jr. Street, San Francisco, CA 94107, États-Unis.
        <a href="https://github.com">github.com</a>
      </p>
    </section>

    <section aria-labelledby="propriete">
      <h2 id="propriete">Propriété des contenus</h2>
      <p>
        Les textes, la mise en page et les créations présentés sur ce site sont protégés par le droit d’auteur. Toute
        reproduction, même partielle, demande une autorisation préalable.
      </p>
      <p>
        Les marques et les visuels des projets appartiennent à leurs propriétaires respectifs. Ils sont montrés ici comme
        références de travail&nbsp;; les crédits figurent sur la page de chaque projet.
      </p>
    </section>

    <section aria-labelledby="typographies">
      <h2 id="typographies">Typographies</h2>
      <p>Readex Pro et Poppins, sous licence libre SIL Open Font License, hébergées sur ce site.</p>
    </section>

    <section aria-labelledby="donnees">
      <h2 id="donnees">Données personnelles</h2>
      <p>
        Ce site ne dépose aucun cookie. Ce que deviennent les informations envoyées par le formulaire est expliqué sur la
        page <a href={url('/confidentialite/')}>Confidentialité</a>.
      </p>
    </section>
  </div>
</Base>
