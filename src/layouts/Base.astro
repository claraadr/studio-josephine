---
import '../styles/global.css';
import '../styles/site.css';
import EnTete from '../components/EnTete.astro';
import PiedDePage from '../components/PiedDePage.astro';
import { url } from '../lib/url';
import { indexation } from '../config';

interface Props {
  /** Titre de la page, sans le nom du studio (ajouté automatiquement). */
  titre: string;
  description: string;
  /** true : le titre est utilisé tel quel (accueil). */
  titreComplet?: boolean;
  /** false : page jamais proposée aux moteurs de recherche (guide de styles, confirmation…). */
  indexer?: boolean;
  /** Données structurées (schema.org) de la page. */
  donneesStructurees?: Record<string, unknown>;
}

const { titre, description, titreComplet = false, indexer = true, donneesStructurees } = Astro.props;
const titreFinal = titreComplet ? titre : `${titre} — Studio Joséphine`;
const canonique = new URL(Astro.url.pathname, Astro.site).href;
const imagePartage = new URL(url('/partage.png'), Astro.site).href;
const indexable = indexation && indexer;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreFinal}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Studio Joséphine" />
    <meta property="og:title" content={titreFinal} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imagePartage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Studio Joséphine, Clara Audureau, graphiste et webdesigner indépendante" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={url('/fonts/readex-pro-var-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/poppins-regular-latin.woff2')} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f3eee6" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {donneesStructurees && <script type="application/ld+json" set:html={JSON.stringify(donneesStructurees)} />}
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <EnTete />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <PiedDePage />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
